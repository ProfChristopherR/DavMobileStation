# ========================================================
# CONFIGURACIÓN DEL SISTEMA DE PRONÓSTICO DAV MOBILE
# ========================================================

# Identificador de la estación
ESTACION_ID=EST_SAN_NICOLAS_01

# URL de consulta de la capa de mediciones históricas (FeatureServer/0)
ARCGIS_QUERY_URL=https://services4.arcgis.com/RZghiOOKLo2VeJGO/arcgis/rest/services/Estacion_Metereologica/FeatureServer/0/query

# URL de inserción en la tabla de pronósticos (addFeatures)
# Reemplaza con la URL generada al crear la tabla 'Pronostico_Estacion'
ARCGIS_PRONOSTICO_URL=https://services4.arcgis.com/RZghiOOKLo2VeJGO/arcgis/rest/services/Pronostico_Estacion/FeatureServer/0/addFeatures

# Credenciales de ArcGIS (Opcionales si la tabla tiene addFeatures anónimo, requeridas si está protegida)
ARCGIS_USERNAME=
ARCGIS_PASSWORD=

# Parámetros del modelo
HORAS_PRONOSTICO=6
DIAS_HISTORICO_CONSULTA=7
MODELO_CHRONOS=amazon/chronos-bolt-small
